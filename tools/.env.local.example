# Copy to tools\.env.local (gitignored) and fill in. Kartik fills the credentials himself.
HOLOLENS_IP=192.168.137.xxx
HOLOLENS_USER=
HOLOLENS_PASS=
# USB cable fallback (HoloLens 1): HOLOLENS_IP=127.0.0.1:10080 and HOLOLENS_SCHEME=http
HOLOLENS_SCHEME=
# Only for the WinAppDeployCmd fallback, if the device asks for a pairing PIN:
HOLOLENS_PIN=
