# Copy to vision/.env.local (gitignored) and fill in, or export these in your shell before `npm run dev`.
# The relay reads them on the server; they are never sent to the browser.

# HoloLens Device Portal (same names as tools/.env.local on the Windows machine)
HOLOLENS_IP=192.168.137.xxx
HOLOLENS_USER=
HOLOLENS_PASS=
# Optional: pin the headset's self-signed certificate (SHA-256 fingerprint, colons optional).
# The relay prints the fingerprint it saw on first connect.
# HOLOLENS_CERT_SHA256=

# Gemini (the Attending). The key stays on the server; the page only ever gets short-lived tokens.
GEMINI_API_KEY=
# GEMINI_LIVE_MODEL=

# Port for VIPER Vision on this Mac (default 4747)
# VISION_PORT=4747
